rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /submissions/{id} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }
    match /formConfigs/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /organizations/{id}  { allow read, write: if request.auth != null; }
    match /cardTemplates/{id}  { allow read, write: if request.auth != null; }
    match /notifications/{id}  { allow read, write: if request.auth != null; }
    match /orgUsers/{id}       { allow read, write: if request.auth != null; }
  }
}